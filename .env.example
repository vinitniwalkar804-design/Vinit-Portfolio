# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/portfolio

# Server port
PORT=5500

# Optional: restrict CORS to a specific origin.
# Leave empty if frontend + backend are served from the same origin (default setup).
# Example: CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=

# SMTP host for sending contact-form email notifications.
# Gmail example: smtp.gmail.com (requires an app password for EMAIL_PASSWORD)
EMAIL_HOST=
# SMTP port (587 for STARTTLS, 465 for implicit TLS)
EMAIL_PORT=587
# Sender mailbox used for authentication + the From header.
# Must be a bare address (you@gmail.com) — do NOT paste a connection string here.
EMAIL_USER=
# SMTP password / app password — keep in .env only, never commit.
# For Gmail this must be a 16-character Google App Password with no spaces.
EMAIL_PASSWORD=
# Where contact-form notifications are delivered
CONTACT_RECEIVER=vinitniwalkar804@gmail.com
# Display name used in the From header (optional)
EMAIL_FROM_NAME=Portfolio Contact
# Set to true to expose non-secret SMTP diagnostics on /api/health
# (host, port, missing vars, shape warnings). Never exposes the password.
EMAIL_DIAGOSTICS=false
# Optional SMTP timeouts in ms (defaults: 10000 / 10000 / 15000)
# EMAIL_CONNECTION_TIMEOUT_MS=10000
# EMAIL_GREETING_TIMEOUT_MS=10000
# EMAIL_SOCKET_TIMEOUT_MS=15000

# --- Resume CMS file storage -------------------------------------------------
# REQUIRED IN PRODUCTION. The Vercel function filesystem is read-only and
# ephemeral, so resume uploads must go to durable object storage.
#
# 1. Vercel dashboard -> Storage -> create a Blob store (public access)
# 2. Store settings -> connect the project, or create a read-write token
# 3. Paste the token below (starts with "vercel_blob_rw_")
#
# With this set, admin resume uploads are stored in Blob under
# BLOB_RESUME_PREFIX and served through the stable URL
# /assets/Vinit-Niwalkar-Resume.pdf. Certificate PDFs are stored the same way
# under "certificates/". Leave it empty locally to keep using the
# frontend/public folder for development. On Vercel without it, uploads fail
# with 503 rather than writing to a filesystem that is discarded with the
# instance.
# BLOB_READ_WRITE_TOKEN=
# Optional: object-name prefix for resume objects (default: resumes)
# BLOB_RESUME_PREFIX=resumes
# Optional: timeout when fetching the active resume back, in ms
# BLOB_FETCH_TIMEOUT_MS=10000
# Optional: how long a public download waits for MongoDB before falling back
# to the copy bundled with the deployment, in ms
# RESUME_DB_WAIT_MS=4000